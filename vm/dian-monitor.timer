[Unit]
Description=Dispara el monitor de citas DIAN cada 3 minutos

[Timer]
# Cada 3 minutos, todo el dia. El propio script sale sin hacer nada fuera del
# horario de vigilancia (--respetar-horario). Si una revision lenta sigue
# corriendo cuando toca la siguiente, systemd no lanza otra encima.
OnCalendar=*-*-* *:00/3:00
# Sin desfase aleatorio y con precision al segundo: dispara en la hora cerrada.
RandomizedDelaySec=0
AccuracySec=1s
# Si la VM estuvo apagada, no dispara una tanda de revisiones atrasadas.
Persistent=false
Unit=dian-monitor.service

[Install]
WantedBy=timers.target
