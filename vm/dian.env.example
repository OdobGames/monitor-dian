# Configuracion del monitor DIAN en la VM.
# Se copia a /opt/dian/dian.env con permisos 600 (contiene una clave).
# Ojo: systemd lee esto tal cual, sin comillas ni expansion de variables.

DIAN_CORREO_DESTINO=tu_correo@gmail.com
DIAN_CORREO_ORIGEN=tu_correo@gmail.com
# Clave de aplicacion de Google (myaccount.google.com/apppasswords), con o sin espacios
DIAN_CLAVE_APP=xxxx xxxx xxxx xxxx

# "videoatencion" o "presencial"
DIAN_MODALIDAD=videoatencion

# Horario de vigilancia, hora de Colombia
DIAN_HORA_INICIO=5
DIAN_HORA_FIN=21

# Limpieza
DIAN_MAX_LOG_BYTES=1000000
DIAN_DIAS_CAPTURAS=3
DIAN_MAX_SALIDA_MB=50
