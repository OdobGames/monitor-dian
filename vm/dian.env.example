# Configuracion del monitor DIAN.
# En la VM se copia a /opt/dian/dian.env con permisos 600 (lleva claves).
# En el PC se copia como dian.env junto a check_dian_v5.py (no sube a git).
# Sin comillas ni expansion de variables. Cada canal es opcional: el que
# quede vacio no se usa. Como sacar cada dato: LEEME.md.

# ntfy (recomendado): push al celular con alarma. Inventa un nombre largo y
# dificil de adivinar, y suscribete a ese mismo nombre en la app ntfy.
DIAN_NTFY_TOPIC=

# Telegram: token de @BotFather y tu chat_id
DIAN_TELEGRAM_TOKEN=
DIAN_TELEGRAM_CHAT_ID=

# Llamada telefonica (Twilio). Numeros con +57 adelante.
DIAN_TWILIO_SID=
DIAN_TWILIO_TOKEN=
DIAN_TWILIO_FROM=
DIAN_TWILIO_TO=

# WhatsApp (CallMeBot)
DIAN_WHATSAPP_PHONE=
DIAN_WHATSAPP_APIKEY=

# Correo (clave de aplicacion de Google, no la del correo)
DIAN_CORREO_DESTINO=
DIAN_CORREO_ORIGEN=
DIAN_CLAVE_APP=

# "ambas", "presencial" o "videoatencion"
DIAN_MODALIDAD=ambas

# Cada cuanto revisar, en segundos, y horario (hora de Colombia)
DIAN_INTERVALO_SEG=180
DIAN_HORA_INICIO=5
DIAN_HORA_FIN=21

# Solo PC con Windows: usar el Edge o el Chrome instalados en vez de bajar
# Chromium. Valores: msedge o chrome. En la VM y en GitHub se deja vacio.
DIAN_NAVEGADOR_CANAL=

# Limpieza
DIAN_MAX_LOG_BYTES=1000000
DIAN_DIAS_CAPTURAS=3
DIAN_MAX_SALIDA_MB=50
